# Host ports published by Docker. Container ports stay at OpenVPN defaults
# (UDP 1194, TCP 443). 443 on the host is already in use on dehost.

OVPN_DATA=/root/openvpn-pki
CONTAINER_NAME=openvpn
PUBLIC_HOST=13.143.223.160

# Client TCP fallback — container still listens on 443
# Publish a free host port instead of 443.
HOST_HTTPS_PORT=8443

# OpenVPN UDP (preferred data channel)
HOST_UDP_PORT=1194

# Concurrent tunnels. Community OpenVPN has no 2-connection license;
# this is the daemon ceiling (each protocol uses a /16 pool).
MAX_CLIENTS=4096

# krakkenVPN bot (create it with @BotFather). The admin username may pick
# any OpenVPN username on /create; everyone else gets a profile named after
# their Telegram handle. With or without the leading @.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_USERNAME=
