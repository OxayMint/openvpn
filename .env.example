# Host ports published by Docker. Container ports stay at OpenVPN AS defaults.
# 443 on the host is already in use on dehost; map the client HTTPS/TCP port elsewhere.

OVPN_DATA=/root/openvpn-data
CONTAINER_NAME=openvpn-as
PUBLIC_HOST=13.143.223.160

# Admin UI (HTTPS) — OpenVPN AS listens on 943 inside the container
HOST_ADMIN_PORT=943

# Client portal + OpenVPN TCP — container still listens on 443
# Publish a free host port instead of 443.
HOST_HTTPS_PORT=8443

# OpenVPN UDP (preferred data channel)
HOST_UDP_PORT=1194

# krakkenVPN bot (create it with @BotFather). The admin username may pick
# any OpenVPN username on /create; everyone else gets a profile named after
# their Telegram handle. With or without the leading @.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_USERNAME=
